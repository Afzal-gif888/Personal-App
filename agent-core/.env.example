# Copy to .env and adjust. Every value can also be set as an environment variable.
# Never commit real credentials. Keep comments on their own lines: an inline comment
# after an empty value is read as the value.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

AGENT_CORE_PORT=8001
# Shared secret the backend sends as `Authorization: Bearer ...`. Required in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_CORE_SERVICE_TOKEN=

# LLM: openrouter = OpenRouter. LLM_API_KEY is an OpenRouter key (sk-or-v1-...) from openrouter.ai/keys.
#                    Free ':free' models: 20 requests/minute, 50/day (1,000/day after buying $10 of credit).
#      gemini     = Google Gemini. LLM_API_KEY is a Gemini API key from aistudio.google.com (free tier available).
#      anthropic  = Claude. LLM_API_KEY is a Claude API key from console.anthropic.com (paid API).
# There is no mock mode: without LLM_API_KEY the assistant replies that it isn't set up.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Defaults: qwen/qwen3.8-27b:free (openrouter), gemini-3.8-flash (gemini), claude-opus-5 (anthropic).
# LLM_FALLBACK_MODELS (openrouter/gemini): comma-separated backups; OpenRouter tries them inside one request.
LLM_MODEL=
LLM_MAX_TOKENS=16000
# Anthropic only: re-run declined requests on Anthropic's recommended fallback model.
LLM_REFUSAL_FALLBACK=true
# Request budget for model calls (0 = unlimited). Keep below your provider's free limits:
# once reached, the assistant says 'try again later' without spending a request.
LLM_MAX_REQUESTS_PER_MINUTE=15
LLM_MAX_REQUESTS_PER_DAY=45
# One extra LLM call to plan multi-step requests. Set false to save free-tier quota.
LLM_PLANNING=false

# The AgentOS FastAPI backend (without /api/v1). The Agent Core never connects to the database.
BACKEND_API_URL=http://localhost:8000

# Loop safety.
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=20

# Approvals: "direct" runs create/update tools immediately, "approval" queues them too.
# Deletes and other consequential actions always need approval.
MUTATION_POLICY=direct
APPROVAL_TTL_SECONDS=259200

# RAG. VECTOR_STORE: "" or memory. EMBEDDING_PROVIDER: "" or hashing.
VECTOR_STORE=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
