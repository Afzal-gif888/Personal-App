# Copy to backend/.env and adjust. Every setting can also be set as an environment variable.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# postgres:// and postgresql:// URLs are accepted; the psycopg 3 driver is added automatically.
# PostgreSQL with pgvector: `docker compose up -d db` in the project root (see docker-compose.yml).
DATABASE_URL=postgresql://agentos:agentos@127.0.0.1:5433/agentos

# Required in production (the app refuses to start with the dev defaults). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Only used with AGENT_CORE_MODE=local: "anthropic" plus LLM_API_KEY. Empty = not configured
# (the assistant then replies that it isn't set up; there is no mock mode).
# "" | anthropic
LLM_PROVIDER=
LLM_API_KEY=
# defaults to claude-opus-5
LLM_MODEL=
LLM_REFUSAL_FALLBACK=true      # re-run declined requests on Anthropic's recommended fallback model
LLM_MAX_TOKENS=16000

# local = the backend's built-in agent loop.
# http  = backend loop; only model calls go to the Agent Core (/v1/complete).
# agent = the Agent Core's LangGraph agent runs the conversation (/agent/run); the backend
#         persists runs, tool calls and approvals and has the Agent Core execute approved actions.
AGENT_CORE_MODE=local
AGENT_CORE_URL=
AGENT_CORE_SERVICE_TOKEN=
APPROVAL_TTL_HOURS=72
AGENT_MAX_ITERATIONS=8

STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# The website(s) allowed to call the API: comma-separated, or a JSON array. No wildcard in production.
# Trailing slashes, quotes and capitals are tidied automatically. The startup log lists what was applied.
CORS_ORIGINS=http://localhost:5173
# Optional: also allow origins matching a regex, e.g. every Vercel deployment URL of this project
# (they change on each deploy): ^https://its-personal-[a-z0-9]+-xdark1\.vercel\.app$
CORS_ORIGIN_REGEX=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30

# Run the notification scheduler inside the API process (single instance only), or run
# `python -m scripts.run_scheduler` separately instead.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Email through EmailJS (https://www.emailjs.com), called from the backend only. Required: sign-in
# emails a 6-digit code, so without these nobody can log in.
# Dashboard: Email Services -> service id; Account -> General -> Public Key / Private Key;
# Account -> Security -> enable "Allow EmailJS API for non-browser applications".
# Templates: set "To Email" to {{to_email}} in both.
#   EMAILJS_TEMPLATE_ID              login code: uses {{name}} and {{otp}}
#   EMAILJS_NOTIFICATION_TEMPLATE_ID reminders + password reset: subject {{subject}}, body {{message}}
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
APP_BASE_URL=http://localhost:5173

# Document search (RAG): Gemini embeddings stored in PostgreSQL + pgvector (backend only).
# Documents are embedded once at upload; each search embeds only the question.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector(768) column (migration 0006).
EMBEDDING_DIMENSIONS=768
DOCUMENT_SEARCH_TOP_K=5
DOCUMENT_SEARCH_MIN_SIMILARITY=0.65
